# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Football data provider
FOOTBALL_DATA_ORG_TOKEN=
API_FOOTBALL_KEY=
# FOOTBALL_PROVIDER: footballDataOrg | apiFootball | llm (ADR-0009, LLM web-search live results)
FOOTBALL_PROVIDER=llm
# RESULTS_MODEL: model used by the LLM web-search results provider (default: claude-haiku-4-5)
RESULTS_MODEL=claude-haiku-4-5

# Cron auth (Vercel cron / manual sync)
CRON_SECRET=

# Luis de la Tracker (AI prediction-strategy tracker)
# ANTHROPIC_API_KEY  — required for the LLM verbalization. Without it the daily
#                      cron still runs and stores an "analysis_only" report.
# TRACKER_MODEL      — optional model override (default: claude-opus-4-8).
# NEXT_PUBLIC_LUIS_PHOTO_URL — optional, swap the míster's photo without a deploy.
ANTHROPIC_API_KEY=
TRACKER_MODEL=
NEXT_PUBLIC_LUIS_PHOTO_URL=
